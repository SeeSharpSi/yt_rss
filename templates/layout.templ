package templates

// User represents the data for the currently logged-in user.
type User struct {
	ID       int
	Username string
	Theme    string
}

templ Layout(user User, content templ.Component) {
	<html>
		<head>
			<title>YT RSS</title>
			<meta name="viewport" content="width=device-width, initial-scale=1.0">
			<script src="https://unpkg.com/htmx.org@1.9.10"></script>
			@ThemeVariables(user.Theme)
			<style>
				/* --- Design System (Shared) --- */
				:root {
					/* Typography */
					--font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol";
					
					/* Sizing & Spacing */
					--border-radius: 0.75rem;
					--shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.1);
					--shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.2), 0 4px 6px -4px rgb(0 0 0 / 0.2);
					--spacing-1: 0.25rem;
					--spacing-2: 0.5rem;
					--spacing-3: 1rem;
					--spacing-4: 1.5rem;
					--spacing-5: 2rem;
					--spacing-6: 3rem;
				}

				/* --- Base & Layout (Theme-agnostic) --- */
				*, *::before, *::after {
					box-sizing: border-box;
				}

				body {
					font-family: var(--font-sans);
					background-color: var(--bg-primary);
					color: var(--text-primary);
					margin: 0;
					padding: var(--spacing-4);
					line-height: 1.6;
				}

				main {
					max-width: 1200px;
					margin: 0 auto;
					width: 100%;
				}

				.main-header {
					display: flex;
					justify-content: space-between;
					align-items: center;
					flex-wrap: wrap;
					gap: var(--spacing-3);
					margin-bottom: var(--spacing-4);
				}

				h1 {
					font-size: 2.5rem;
					font-weight: 700;
					text-align: center;
					margin: 0;
					cursor: pointer;
					user-select: none;
					letter-spacing: -0.5px;
				}

				a {
					color: var(--accent-primary);
					text-decoration: none;
					transition: opacity 0.2s ease;
				}
				a:hover {
					opacity: 0.8;
					text-decoration: none;
				}

				/* --- Channels & Forms --- */
				#channels {
					margin-bottom: var(--spacing-5);
					padding: var(--spacing-4);
					background-color: var(--bg-secondary);
					border: 1px solid var(--border-color);
					border-radius: var(--border-radius);
					box-shadow: var(--shadow-sm);
				}

				fieldset {
					border: none;
					padding: 0;
					margin: 0;
				}

				#channels-list fieldset {
					margin-bottom: var(--spacing-4);
				}

				#channels-list fieldset:last-child {
					margin-bottom: 0;
				}

				legend {
					font-size: 1.25rem;
					font-weight: 600;
					margin-bottom: var(--spacing-3);
					color: var(--text-primary);
				}

				.form-row {
					display: flex;
					gap: var(--spacing-2);
					align-items: center;
				}

				.secondary-buttons {
					display: grid;
					grid-template-columns: 1fr 1fr;
					gap: var(--spacing-2);
					margin-top: var(--spacing-3);
				}

				.secondary-buttons .button {
					background-color: var(--bg-primary);
					color: var(--text-secondary);
					border: 1px solid var(--border-color);
				}
				.secondary-buttons .button:hover {
					background-color: var(--border-color);
					color: var(--text-primary);
				}

				#channels-list ul {
					list-style: none;
					padding: 0;
					margin: 0;
					display: grid;
					grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
					gap: var(--spacing-1);
				}

				#channels-list li {
					display: flex;
					align-items: center;
					gap: 0.125rem;
					background-color: var(--bg-primary);
					padding: 0.125rem var(--spacing-1);
					border-radius: 0.25rem;
					border: 1px solid var(--border-color);
					font-size: 0.75rem;
					line-height: 1.2;
					min-width: 0; /* Allow flex items to shrink */
					min-height: 1.5rem;
				}

				#channels-list li label {
					flex: 1;
					min-width: 0;
					overflow: hidden;
					text-overflow: ellipsis;
					white-space: nowrap;
					font-weight: 500;
					cursor: pointer;
				}

				.channel-item {
					cursor: pointer;
					transition: all 0.2s ease;
					user-select: none;
				}

				.channel-item:hover {
					background-color: var(--border-color);
				}

				.channel-item.selected {
					background-color: var(--accent-primary);
					color: var(--bg-primary);
					border-color: var(--accent-primary);
				}

				.channel-item.selected .channel-name {
					font-weight: 600;
				}

				.channel-item .channel-name {
					flex: 1;
					min-width: 0;
					overflow: hidden;
					text-overflow: ellipsis;
					white-space: nowrap;
					font-weight: 500;
					pointer-events: none;
				}

				input[type="checkbox"] {
					width: 1em;
					height: 1em;
					flex-shrink: 0;
					accent-color: var(--accent-primary);
				}

				input[type="text"],
				input[type="password"] {
					padding: var(--spacing-2) var(--spacing-3);
					border: 1px solid var(--border-color);
					border-radius: var(--border-radius);
					font-size: 1rem;
					background-color: var(--bg-primary);
					color: var(--text-primary);
					flex-grow: 0;
					flex-shrink: 1;
					min-width: 200px;
					max-width: 400px;
					width: 100%;
				}

				/* Responsive form styling */
				@media (max-width: 768px) {
					input[type="text"],
					input[type="password"] {
						min-width: 150px;
						max-width: none;
						flex-grow: 1;
					}
				}

				button, .button {
					padding: var(--spacing-2) var(--spacing-3);
					border: 1px solid transparent;
					border-radius: var(--border-radius);
					font-size: 1rem;
					font-weight: 600;
					cursor: pointer;
					transition: all 0.2s ease;
					white-space: nowrap;
					text-align: center;
				}

				button[type="submit"] {
					background-color: var(--accent-primary);
					color: var(--bg-primary);
					border-color: var(--accent-primary);
				}
				button[type="submit"]:hover {
					opacity: 0.9;
					transform: translateY(-1px);
				}

				.delete-btn {
					background-color: transparent;
					color: var(--accent-danger);
					padding: 0.125rem;
					font-size: 0.75rem;
					border: none;
					flex-shrink: 0;
					width: 1.2em;
					height: 1.2em;
					display: flex;
					align-items: center;
					justify-content: center;
					border-radius: 0.125rem;
				}
				.delete-btn:hover {
					background-color: var(--accent-danger);
					color: white;
				}

				.logout-btn {
					background-color: var(--bg-primary);
					color: var(--text-primary);
					border: 1px solid var(--border-color);
				}
				.logout-btn:hover {
					background-color: var(--border-color);
				}

				/* --- Videos Grid --- */
				#videos {
					display: grid;
					grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
					gap: var(--spacing-4);
				}

				.video {
					background-color: var(--bg-secondary);
					border: 1px solid var(--border-color);
					border-radius: var(--border-radius);
					overflow: hidden;
					box-shadow: var(--shadow-sm);
					transition: transform 0.2s ease, box-shadow 0.2s ease;
					display: flex;
					flex-direction: column;
				}
				.video:hover {
					transform: translateY(-5px);
					box-shadow: var(--shadow-lg);
				}

				.video a {
					display: flex;
					flex-direction: column;
					height: 100%;
					color: var(--text-primary);
					position: relative;
				}
				.video a:hover {
					opacity: 1;
				}

				.thumbnail-container {
					position: relative;
					padding-top: 56.25%; /* 16:9 Aspect Ratio */
					height: 0;
					overflow: hidden;
				}

				.live-icon {
					position: absolute;
					bottom: 10px;
					left: 10px;
					background-color: var(--accent-danger);
					color: white;
					padding: 2px 8px;
					border-radius: var(--border-radius);
					font-size: 0.75rem;
					font-weight: 600;
					text-transform: uppercase;
					z-index: 1;
				}

				.video img {
					position: absolute;
					top: 0;
					left: 0;
					width: 100%;
					height: 100%;
					object-fit: cover;
					border-bottom: 1px solid var(--border-color);
				}

				.video-info {
					padding: var(--spacing-3);
					display: flex;
					flex-direction: column;
					justify-content: space-between;
					flex-grow: 1;
				}

				.video-title {
					margin: 0 0 var(--spacing-2) 0;
					font-size: 1.05rem;
					line-height: 1.4;
					font-weight: 600;
					color: var(--text-primary);
				}

				.video-meta {
					display: flex;
					justify-content: space-between;
					align-items: center;
					margin-top: auto;
				}

				.channel-name, .upload-date {
					margin: 0;
					font-size: 0.875rem;
					color: var(--text-secondary);
				}
				
				#load-more {
					grid-column: 1 / -1;
					text-align: center;
					padding: var(--spacing-4);
					font-weight: 500;
					color: var(--text-secondary);
				}

				/* --- HTMX Loading Indicator --- */
				.htmx-indicator {
					position: fixed;
					top: 50%;
					left: 50%;
					transform: translate(-50%, -50%);
					z-index: 9999;
					opacity: 0;
					transition: opacity 200ms ease-in;
					pointer-events: none;
				}
				.htmx-request .htmx-indicator {
					opacity: 1;
					pointer-events: auto;
				}
				.htmx-request.htmx-indicator {
					opacity: 1;
					pointer-events: auto;
				}
				.spinner {
					width: 60px;
					height: 60px;
					border: 6px solid var(--text-secondary);
					border-top-color: var(--accent-primary);
					border-radius: 50%;
					animation: spin 1s linear infinite;
				}
				@keyframes spin {
					to {
						transform: rotate(360deg);
					}
				}

				/* --- Auth Page --- */
				.auth-container {
					max-width: 420px;
					margin: var(--spacing-6) auto;
					padding: var(--spacing-5);
					background-color: var(--bg-secondary);
					border: 1px solid var(--border-color);
					border-radius: var(--border-radius);
				}
				.auth-container h2 {
					text-align: center;
					margin-bottom: var(--spacing-4);
					font-size: 1.75rem;
				}
				.auth-container form {
					display: flex;
					flex-direction: column;
					gap: var(--spacing-3);
				}
				.auth-container .error {
					color: var(--accent-danger);
					background-color: color-mix(in srgb, var(--accent-danger) 20%, transparent);
					padding: var(--spacing-2) var(--spacing-3);
					border-radius: var(--border-radius);
					text-align: center;
					margin: 0;
				}
				.auth-container p {
					text-align: center;
					margin-top: var(--spacing-4);
				}

				/* --- Video Page --- */
				body:has(.full-screen-video-page) {
					padding: 0;
					overflow-x: hidden; /* Prevent horizontal scrollbar caused by 100vw */
				}
				.full-screen-video-page {
					width: 100vw;
					display: flex;
					flex-direction: column;
					position: relative;
					left: 50%;
					transform: translateX(-50%);
				}
				.video-wrapper {
					width: 100%;
					height: 100vh;
					background: #000;
				}
				.video-wrapper iframe {
					width: 100%;
					height: 100%;
					border: none;
				}
				.back-button-container {
					text-align: center;
					padding: var(--spacing-4);
					background-color: var(--bg-primary);
				}
				.back-btn {
					background-color: var(--bg-secondary);
					border: 1px solid var(--border-color);
					color: var(--text-primary);
				}
				.summary-container {
					max-width: 1200px;
					margin: 0 auto;
					padding: var(--spacing-4);
					background-color: var(--bg-secondary);
					border: 1px solid var(--border-color);
					border-radius: var(--border-radius);
					box-shadow: var(--shadow-sm);
					margin-bottom: var(--spacing-5);
				}
				.summary-title {
					font-size: 1.25rem;
					font-weight: 600;
					margin-bottom: var(--spacing-3);
					color: var(--accent-primary);
					display: flex;
					justify-content: space-between;
					align-items: center;
				}
				.refresh-btn {
					background: none;
					border: none;
					color: var(--accent-primary);
					font-size: 1.2rem;
					cursor: pointer;
					padding: 0.25rem;
					border-radius: 0.25rem;
					transition: all 0.2s ease;
					display: flex;
					align-items: center;
					justify-content: center;
					width: 2rem;
					height: 2rem;
				}
				.refresh-btn:hover {
					background-color: var(--accent-primary);
					color: var(--bg-primary);
					transform: rotate(90deg);
				}
				.refresh-btn:active {
					transform: rotate(180deg);
				}
				.summary-content {
					line-height: 1.6;
					color: var(--text-primary);
					margin: 0;
				}
				.timestamp-link {
					color: var(--accent-primary);
					text-decoration: none;
					font-weight: 600;
					transition: opacity 0.2s ease;
				}
				.timestamp-link:hover {
					opacity: 0.8;
					text-decoration: underline;
				}

				/* --- Popup Modals --- */
				.popup-overlay {
					position: fixed;
					top: 0;
					left: 0;
					width: 100%;
					height: 100%;
					background: rgba(0, 0, 0, 0.7);
					display: flex;
					align-items: center;
					justify-content: center;
					z-index: 2000;
					backdrop-filter: blur(4px);
					padding: var(--spacing-3);
				}
				.popup-content {
					background: var(--bg-secondary);
					padding: var(--spacing-4);
					border-radius: var(--border-radius);
					border: 1px solid var(--border-color);
					width: 100%;
					max-width: 600px;
					display: flex;
					flex-direction: column;
					gap: var(--spacing-4);
					box-shadow: var(--shadow-lg);
				}
				.popup-content form {
					display: flex;
					flex-direction: column;
					gap: var(--spacing-4);
				}
				.popup-content h3 {
					margin: 0;
					font-size: 1.5rem;
					font-weight: 600;
				}
				.popup-content textarea {
					width: 100%;
					min-height: 200px;
					resize: vertical;
					background: var(--bg-primary);
					color: var(--text-primary);
					border: 1px solid var(--border-color);
					border-radius: var(--border-radius);
					padding: var(--spacing-2);
					font-family: monospace;
				}
				.popup-buttons {
					display: flex;
					justify-content: flex-end;
					gap: var(--spacing-2);
				}
				.popup-content .close-btn {
					background-color: var(--bg-primary);
					color: var(--text-primary);
					border: 1px solid var(--border-color);
				}
			</style>
		</head>
		<body>
			<!-- Global Loading Indicator -->
			<div id="loading-spinner" class="htmx-indicator">
				<div class="spinner"></div>
			</div>

			<main>
				@content
			</main>
		</body>
	</html>
}
